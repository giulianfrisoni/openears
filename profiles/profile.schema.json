{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenEars device profile document, version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "profile"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "$ref": "#/$defs/profile"
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "experimental",
            "verified"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "attribution": {
      "type": "object",
      "required": [
        "authors",
        "source",
        "license",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+"
        },
        "license": {
          "type": "string",
          "pattern": "\\S"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "vendor",
        "driver",
        "model",
        "names",
        "features",
        "attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        }
      }
    }
  }
}
